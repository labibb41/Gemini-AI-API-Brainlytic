# Port Server
PORT=3000

# Google Gemini API Key Utama (Dapatkan di https://aistudio.google.com/)
GEMINI_API_KEY=masukkan_api_key_gemini_anda_di_sini

# (Opsional) Google Gemini API Key Cadangan jika kuota utama habis
GEMINI_API_KEY_BACKUP=

# Model Gemini yang digunakan (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
